{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:brain-openfang-handoff:v1",
  "title": "BrainOpenFangHandoffV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "execution_mode",
    "execution_boundary",
    "correlation_id",
    "plan_id",
    "lifecycle_revision",
    "brain_task_node_id",
    "space_id",
    "roles",
    "approval_ref",
    "cost_ref",
    "retry"
  ],
  "properties": {
    "contract_version": {"const": "v1"},
    "execution_mode": {"const": "cognitive"},
    "execution_boundary": {"const": "openfang"},
    "correlation_id": {"$ref": "#/$defs/correlationId"},
    "plan_id": {"$ref": "#/$defs/planId"},
    "lifecycle_revision": {"type": "integer", "minimum": 1},
    "brain_task_node_id": {"$ref": "#/$defs/taskNodeId"},
    "space_id": {"$ref": "#/$defs/canonicalSpaceId"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/roleRequirement"}
    },
    "approval_ref": {"$ref": "#/$defs/opaqueReference"},
    "cost_ref": {"$ref": "#/$defs/opaqueReference"},
    "retry": {"$ref": "#/$defs/retry"}
  },
  "$defs": {
    "correlationId": {
      "type": "string",
      "pattern": "^(?:task|event|evidence|handoff|todo|approval|plan|request|job|result|trace|quote|artifact|citation|schedule|change|run|intent|project|workflow|definition|capability|log|source|repository|base|head|branch|commit|pr|worktree|test_profile|test_summary|checkpoint|cancellation|projection|delta|ledger|authority|session|receipt|checkin|recommendation|acceptance|subject)_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^plan_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"
    },
    "taskNodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "canonicalSpaceId": {
      "enum": [
        "bubbles",
        "ideas",
        "coding",
        "desktop",
        "research",
        "rowboat",
        "minibook",
        "schedule",
        "n8n",
        "agentfarm",
        "video",
        "flowzen",
        "mirofish"
      ]
    },
    "roleRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "required_agent_count"],
      "properties": {
        "role": {"type": "string", "minLength": 1, "maxLength": 200},
        "required_agent_count": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "opaqueReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "max_attempts"],
      "properties": {
        "classification": {"enum": ["none", "transient"]},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "none"}}, "required": ["classification"]},
          "then": {"properties": {"max_attempts": {"const": 1}}}
        },
        {
          "if": {"properties": {"classification": {"const": "transient"}}, "required": ["classification"]},
          "then": {"properties": {"max_attempts": {"minimum": 2}}}
        }
      ]
    }
  }
}
